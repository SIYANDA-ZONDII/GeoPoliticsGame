@page
@model GeoPoliticsGame.Pages.IndexModel
@{
    ViewData["Title"] = "Geopolitics Game";
}

<partial name="_CampaignLanding" model="@(true)" />

<div class="start-modal" id="startModal"
     role="dialog" aria-modal="true" aria-labelledby="startTitle">

    <div class="campaign-dialog-card">
        <h2 id="startTitle">Start a new game</h2>

        <p>
            Choose the country you want to control.
            Your campaign will begin after you confirm your choice.
        </p>

        <form method="post" asp-page-handler="StartGame">
            <label asp-for="SelectedCountry">Your starting country</label>

            <select asp-for="SelectedCountry" asp-items="Model.CountryOptions">
                <option value="">Select a country</option>
            </select>

            <span asp-validation-for="SelectedCountry"
                  class="validation-message"></span>

            <div asp-validation-summary="ModelOnly"
                 class="validation-message"></div>

            <button type="submit" class="start-button">
                Begin Campaign
            </button>
        </form>
    </div>
</div>

<script>
    const startModal = document.getElementById("startModal");

    document.getElementById("openStartModal").addEventListener("click", () => {
        startModal.classList.remove("hidden");
    });

    // Clicking outside the popup closes it.
    startModal.addEventListener("click", event => {
        if (event.target === startModal) {
            startModal.classList.add("hidden");
        }
    });

    // The popup is visible automatically when the page loads.
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
