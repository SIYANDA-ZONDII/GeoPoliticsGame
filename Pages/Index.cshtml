@page
@model GeoPoliticsGame.Pages.IndexModel
@{
    ViewData["Title"] = "Geopolitics Game";

    var countries = new[]
    {
        new { Name = "Italy", Armies = 5, Color = "#f2b72f" },
        new { Name = "India", Armies = 9, Color = "#d84a9b" },
        new { Name = "Argentina", Armies = 4, Color = "#18a878" },
        new { Name = "Canada", Armies = 4, Color = "#a87852" },
        new { Name = "Japan", Armies = 7, Color = "#e77b32" },
        new { Name = "Australia", Armies = 4, Color = "#13a5b5" },
        new { Name = "United States", Armies = 9, Color = "#3478f6" },
        new { Name = "Indonesia", Armies = 9, Color = "#9560db" },
        new { Name = "Mexico", Armies = 8, Color = "#e05260" },
        new { Name = "Germany", Armies = 6, Color = "#8494aa" }
    };
}

<style>
    .landing {
        min-height: 90vh;
        padding: 22px;
        color: #edf4ff;
        background: #091725;
        border-radius: 16px;
    }

    .landing-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-bottom: 22px;
    }

        .landing-header h1 {
            margin: 0 0 8px;
            color: #f3f7ff;
        }

        .landing-header p {
            margin: 0;
            color: #a9bbd0;
        }

    .territory-card {
        padding: 18px;
        background: #10253a;
        border: 1px solid #29445d;
        border-radius: 14px;
    }

    .territory-heading {
        display: flex;
        justify-content: space-between;
        margin-bottom: 18px;
    }

        .territory-heading h2 {
            margin: 0;
            font-size: 18px;
            color: #f3f7ff;
        }

        .territory-heading span {
            color: #9eb4cc;
        }

    .country-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 20px 12px;
    }

    .country {
        position: relative;
        min-width: 0;
        aspect-ratio: 1.12;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .country svg {
            position: absolute;
            width: 100%;
            height: 100%;
        }

        .country polygon {
            stroke: #091725;
            stroke-width: 5;
            stroke-linejoin: round;
        }

        .country.starting polygon {
            stroke: white;
            stroke-width: 7;
        }

    .country-info {
        position: relative;
        text-align: center;
        color: white;
        padding: 4px;
        overflow-wrap: anywhere;
    }

        .country-info strong {
            display: block;
            font-size: clamp(11px, 1.2vw, 15px);
        }

        .country-info span {
            display: block;
            margin-top: 8px;
            font-size: 12px;
        }

        .country-info small {
            display: block;
            margin-top: 8px;
            font-size: 9px;
        }

    .map-description {
        margin-top: 20px;
        color: #a9bbd0;
        line-height: 1.6;
        font-size: 13px;
    }

    .start-button {
        padding: 12px 22px;
        margin-top: 16px;
        color: white;
        background: #3478f6;
        border: none;
        border-radius: 8px;
        font-weight: bold;
        cursor: pointer;
    }

        .start-button:hover {
            background: #2564d6;
        }

    .start-modal {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 18px;
        background: rgba(3, 10, 20, .82);
        backdrop-filter: blur(5px);
    }

        .start-modal.hidden {
            display: none;
        }

    .modal-content {
        width: 100%;
        max-width: 430px;
        padding: 28px;
        background: #10253a;
        border: 1px solid #365674;
        border-radius: 16px;
        box-shadow: 0 20px 70px #0008;
    }

        .modal-content h2 {
            color: #f3f7ff;
            margin-top: 0;
        }

        .modal-content p {
            color: #a9bbd0;
            line-height: 1.6;
        }

        .modal-content label {
            display: block;
            margin: 18px 0 8px;
            color: #dbeafe;
            font-weight: bold;
        }

        .modal-content select {
            width: 100%;
            padding: 12px;
            color: white;
            background: #091725;
            border: 1px solid #456784;
            border-radius: 8px;
        }

        .modal-content .start-button {
            width: 100%;
        }

    .validation-message {
        color: #ffaaaa;
        font-size: 13px;
    }

    @@media (max-width: 700px) {
        .landing {
            padding: 12px;
        }

        .country-grid {
            gap: 12px 5px;
        }

        .country-info small {
            display: none;
        }
    }

    @@media (max-width: 480px) {
        .country-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .country {
            min-height: 120px;
        }
    }
</style>

<main class="landing">
    <header class="landing-header">
        <div>
            <h1>Geopolitics Game</h1>
            <p>Choose your nation. Build your army. Conquer the world.</p>
        </div>

        <span>10 territories</span>
    </header>

    <section class="territory-card">
        <div class="territory-heading">
            <h2>Territory map</h2>
            <span>10 territories</span>
        </div>

        <div class="country-grid">
            @for (int i = 0; i < countries.Length; i++)
            {
                var country = countries[i];

                <div class="country @(i == 0 ? "starting" : "")">
                    <svg viewBox="0 0 180 158" aria-hidden="true">
                        <polygon points="18,8 142,0 180,35 170,125 120,158 30,145 0,80"
                                 fill="@country.Color" />
                    </svg>

                    <div class="country-info">
                        <strong>@country.Name</strong>
                        <span>@country.Armies soldiers</span>
                        <small>@(i == 0 ? "YOUR NATION" : "TERRITORY")</small>
                    </div>
                </div>
            }
        </div>

        <p class="map-description">
            Click Start Game to begin your campaign. Your actual game
            will load with the interactive map and your selected country.
        </p>

        <button type="button" class="start-button" id="openStartModal">
            Start Game
        </button>
    </section>
</main>

<div class="start-modal" id="startModal"
     role="dialog" aria-modal="true" aria-labelledby="startTitle">

    <div class="modal-content">
        <h2 id="startTitle">Start a new game</h2>

        <p>
            Choose the country you want to control.
            Your campaign will begin after you confirm your choice.
        </p>

        <form method="post" asp-page-handler="StartGame">
            <label asp-for="SelectedCountry">Your starting country</label>

            <select asp-for="SelectedCountry" asp-items="Model.CountryOptions">
                <option value="">Select a country</option>
            </select>

            <span asp-validation-for="SelectedCountry"
                  class="validation-message"></span>

            <div asp-validation-summary="ModelOnly"
                 class="validation-message"></div>

            <button type="submit" class="start-button">
                Begin Campaign
            </button>
        </form>
    </div>
</div>

<script>
    const startModal = document.getElementById("startModal");

    document.getElementById("openStartModal").addEventListener("click", () => {
        startModal.classList.remove("hidden");
    });

    // Clicking outside the popup closes it.
    startModal.addEventListener("click", event => {
        if (event.target === startModal) {
            startModal.classList.add("hidden");
        }
    });

    // The popup is visible automatically when the page loads.
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
