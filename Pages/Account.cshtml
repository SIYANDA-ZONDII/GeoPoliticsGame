@page
@model GeopoliticsGame.Pages.AccountModel

@{
    ViewData["Title"] = Model.Register ? "Create account" : "Sign in";
    var passwordAutocomplete = Model.Register
        ? "new-password"
        : "current-password";
}

<div class="col-md-6 col-lg-4">
    <h1>@ViewData["Title"]</h1>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Register" />

        <div class="mb-3">
            <label asp-for="Username" class="form-label"></label>
            <input asp-for="Username" class="form-control" autocomplete="username" />
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" type="password" class="form-control"
                   autocomplete="@passwordAutocomplete" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            @ViewData["Title"]
        </button>
    </form>

    <a asp-page="/Account" asp-route-register="@(!Model.Register)"
       class="d-inline-block mt-3">
        @(Model.Register ? "Already registered? Sign in" : "Create an account")
    </a>
</div>